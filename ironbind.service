# systemd unit for ironbind.
# Panics are already contained inside the process; this restarts it after the
# failures nothing in-process can catch (OOM kill, SIGKILL, abort).
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin ironbind
#   sudo cp target/release/ironbind /usr/local/bin/
#   sudo mkdir -p /etc/ironbind && sudo cp -r config.toml example.com.zone keys tls /etc/ironbind/
#   sudo chown -R ironbind:ironbind /etc/ironbind
#   sudo cp ironbind.service /etc/systemd/system/ && sudo systemctl enable --now ironbind
#
# A service has no desktop keyring session, so point [tsig] at secret_file instead of secret_keychain.

[Unit]
Description=ironbind DNS server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ironbind /etc/ironbind/config.toml
# Zone files and keys/ are resolved relative to here
WorkingDirectory=/etc/ironbind
Restart=always
RestartSec=1
LimitNOFILE=65536
ExecReload=/bin/kill -HUP $MAINPID

User=ironbind
Group=ironbind
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
